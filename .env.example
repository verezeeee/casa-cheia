# =============================================================================
# Poker System - Variáveis de ambiente
# Copie este arquivo para ".env" na raiz (usado pelo docker-compose) e,
# se necessário, também para apps/backend/.env e apps/frontend/.env.local.
# NUNCA versionar o arquivo ".env" real.
# =============================================================================

# -----------------------------------------------------------------------------
# Node / ambiente
# -----------------------------------------------------------------------------
NODE_ENV=development

# -----------------------------------------------------------------------------
# PostgreSQL (docker-compose)
# -----------------------------------------------------------------------------
POSTGRES_USER=poker
POSTGRES_PASSWORD=poker
POSTGRES_DB=poker_system
POSTGRES_PORT=5432

# String de conexão usada pelo Prisma (apps/backend).
# Deve refletir as credenciais acima. Host "localhost" quando o backend
# roda fora do docker-compose; use o nome do serviço "postgres" se o
# backend também for containerizado.
DATABASE_URL=postgresql://poker:poker@localhost:5432/poker_system?schema=public

# Banco DEDICADO aos testes de integração/e2e. Ele é destrutivo: as suítes
# aplicam migrations e limpam tabelas, por isso nunca deve apontar para o
# banco de desenvolvimento. Suba-o com:
#   docker compose --profile test up -d postgres-test
# Quando definida, esta variável sobrescreve DATABASE_URL dentro das suítes
# (ver apps/backend/test/setup-env.ts). No CI o serviço Postgres do workflow
# já é o banco de teste, então lá basta DATABASE_URL.
DATABASE_URL_TEST=postgresql://poker:poker@localhost:5433/poker_system_test?schema=public
POSTGRES_TEST_PORT=5433
POSTGRES_TEST_DB=poker_system_test

# -----------------------------------------------------------------------------
# pgAdmin (opcional - profile "tools" do docker-compose)
# docker compose --profile tools up -d
# -----------------------------------------------------------------------------
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@poker-system.local
PGADMIN_DEFAULT_PASSWORD=admin

# -----------------------------------------------------------------------------
# Backend (apps/backend)
# -----------------------------------------------------------------------------
PORT=3001
API_PREFIX=api
LOG_LEVEL=info

# Segredo usado para assinar/validar JWTs de autenticação. Gere um valor
# forte em produção, ex: `openssl rand -base64 48`.
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-to-another-long-random-secret
JWT_REFRESH_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# Sessão / cookies
# -----------------------------------------------------------------------------
# Domínio do cookie de refresh token. Deixe VAZIO em desenvolvimento (o
# browser usa o host da resposta). Em produção use o domínio compartilhado
# entre API e frontend, ex: ".poker-system.app".
COOKIE_DOMAIN=

# Marca o cookie de sessão como "Secure" (só trafega sobre HTTPS).
# false em desenvolvimento (http://localhost). Em produção é OBRIGATÓRIO
# ser true: com NODE_ENV=production e COOKIE_SECURE=false o backend se
# recusa a subir (validação Joi em src/config/env.validation.ts).
COOKIE_SECURE=false

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
# Lista de origens autorizadas, separadas por vírgula (sem barra no final).
# Ex: http://localhost:3000,https://app.poker-system.com
CORS_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# Rate limiting (throttler)
# -----------------------------------------------------------------------------
# Janela em segundos e número máximo de requisições por janela, aplicados
# às rotas sensíveis (login, registro, criação de depósito/saque).
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=10

# -----------------------------------------------------------------------------
# Carteira virtual - limites monetários
# -----------------------------------------------------------------------------
# Valores em BRL, sempre no formato decimal "0.00" (string). São tratados
# como Decimal (NUMERIC) pelo Prisma - NUNCA como float - para evitar erro
# de arredondamento binário em operações de saldo.
WALLET_MIN_DEPOSIT=10.00
WALLET_MAX_DEPOSIT=50000.00
WALLET_MIN_WITHDRAWAL=10.00

# -----------------------------------------------------------------------------
# AbacatePay (gateway PIX) - https://abacatepay.com
# -----------------------------------------------------------------------------
# Chave de API usada nas chamadas server-to-server (criação de cobranças PIX,
# saques, etc). Mantenha em segredo, nunca exponha no frontend.
ABACATEPAY_API_KEY=abacatepay_sandbox_your_api_key_here
ABACATEPAY_BASE_URL=https://api.abacatepay.com/v2

# Segredo usado para validar a assinatura dos webhooks recebidos do
# AbacatePay (confirmação de pagamento PIX, estornos, etc). É o principal
# mecanismo anti-fraude do fluxo de depósito: nunca confie em um webhook
# sem validar esta assinatura.
ABACATEPAY_WEBHOOK_SECRET=change-me-abacatepay-webhook-secret

# Janela anti-replay, em segundos: eventos cujo timestamp assinado for mais
# antigo que esta tolerância são descartados mesmo com assinatura válida.
# Impede que um webhook legítimo capturado seja reenviado depois para
# creditar a carteira novamente. Máximo aceito: 3600.
ABACATEPAY_WEBHOOK_TOLERANCE_SECONDS=300

# -----------------------------------------------------------------------------
# Frontend (apps/frontend)
# Variáveis NEXT_PUBLIC_* são embutidas no bundle do cliente - nunca
# coloque segredos aqui.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001/api
